# Generates a C++ source that embeds rule and data files as byte arrays.
# Usage: cmake -DOUT=<file.cpp> -DROOT=<repo root> -DFILES="rel1;rel2;..." -P embed.cmake
file(WRITE "${OUT}.tmp" "// Generated by cmake/embed.cmake. Do not edit.\n#include \"win/embedded.h\"\nnamespace aegis {\n")
set(index 0)
set(table "")
foreach(rel IN LISTS FILES)
  file(READ "${ROOT}/${rel}" hex HEX)
  string(LENGTH "${hex}" hexlen)
  math(EXPR size "${hexlen} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  # Break the array into lines so compilers and editors cope.
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" bytes "${bytes}")
  file(APPEND "${OUT}.tmp" "static const unsigned char kData${index}[] = {\n${bytes}0x00};\n")
  string(APPEND table "  {\"${rel}\", kData${index}, ${size}},\n")
  math(EXPR index "${index} + 1")
endforeach()
file(APPEND "${OUT}.tmp" "const EmbeddedFile kEmbeddedFiles[] = {\n${table}};\nconst size_t kEmbeddedFileCount = ${index};\n}  // namespace aegis\n")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
